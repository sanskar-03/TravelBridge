# --- Django Production Settings ---
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1
DATABASE_URL=postgres://user:password@postgres:5432/travelbridge
REDIS_URL=redis://redis:6379/0

# --- Third Party Integrations ---
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_CLIENT_EMAIL=replace-with-client-email
FIREBASE_PRIVATE_KEY=replace-with-private-key

STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace

CLOUDINARY_CLOUD_NAME=replace
CLOUDINARY_API_KEY=replace
CLOUDINARY_API_SECRET=replace

AI_MODE=mock
AI_PROVIDER=openai
AI_API_KEY=replace

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com
